@model RestaurantFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<h1>Edit @Model.Name</h1>

@* asp-route-id → الـ action بيبقى /Restaurants/Edit/2 → الـ id بيوصل للـ POST Action من الـ URL *@
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    <partial name="_RestaurantForm" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@* Client-side Validation (jQuery Validation + Unobtrusive + validation.js بتاعنا) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
