@model RestaurantFormViewModel
@* Partial View مشترك بين Create و Edit — نفس الحقول بالظبط، نكتبها مرة واحدة بس
   الاسم بيبدأ بـ _ (Convention) = ده Partial مش صفحة كاملة، ومبيستخدمش Layout *@

@* ModelOnly → بيعرض الأخطاء العامة بس (اللي مش مربوطة بحقل معين)
   لو الفورم بيرجع Invalid ومفيش رسالة ظاهرة: غيّرها مؤقتاً لـ "All" وشوف الخطأ فين *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@* Hidden: الـ Id بيرجع مع الـ POST (في Create قيمته 0) *@
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    @* asp-for لوحده بيعمل: id + name + value + type المناسب + كل الـ data-val-* من الـ Annotations
       <label asp-for> بياخد النص من [Display(Name = ...)]
       <span asp-validation-for> مكان رسالة الخطأ (من السيرفر أو من jQuery Validation) *@
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        @* asp-items → بيولّد الـ <option> من الـ SelectList اللي عملناها في FillCategoriesAsync
           الـ option اللي بقيمة 0 هو الاختيار الافتراضي → [Range(1, ...)] بترفضه *@
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="0">-- choose --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        @* [EgyptianPhone] بيضيف data-val-egphone هنا → validation.js بيشغّله في المتصفح *@
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    @* decimal → asp-for بيطلّعه type="text" فالمستخدم يقدر يكتب أرقام عربي "١٥" (validation.js + FlexibleDecimalModelBinder بيفهموها) *@
    <div class="col-md-4">
        <label asp-for="DeliveryFee" class="form-label"></label>
        <input asp-for="DeliveryFee" class="form-control" />
        <span asp-validation-for="DeliveryFee" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MinOrder" class="form-label"></label>
        <input asp-for="MinOrder" class="form-control" />
        <span asp-validation-for="MinOrder" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DeliveryMinutes" class="form-label"></label>
        <input asp-for="DeliveryMinutes" class="form-control" />
        <span asp-validation-for="DeliveryMinutes" class="text-danger"></span>
    </div>
    @* bool → checkbox + hidden input بقيمة false (عشان لو مش متعلّم يوصل false للسيرفر) *@
    <div class="col-12 form-check ms-2">
        <input asp-for="IsOpen" class="form-check-input" />
        <label asp-for="IsOpen" class="form-check-label"></label>
    </div>
</div>
