@model Restaurant
@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index">← Back to restaurants</a>

<div class="d-flex justify-content-between align-items-start mt-3">
    <div>
        <h1>@Model.Name</h1>
        <p class="lead">@Model.Category?.Icon @Model.Category?.Name · ⭐ @Model.AverageRating</p>
    </div>
    @* لينكات Edit / Delete (GET) — الـ Delete بيفتح صفحة تأكيد مش بيمسح على طول *@
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
    </div>
</div>
<p>@Model.Description</p>

@* HTML Helpers (القديمة) — لسه شغالة وبتقرا [Display]
   DisplayNameFor → النص من [Display(Name)] · DisplayFor → القيمة بالفورمات بتاع [DataType] *@
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Address)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Address)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DeliveryFee)</dt>
    <dd class="col-sm-9">@Model.DeliveryFee.ToString("0.00")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.MinOrder)</dt>
    <dd class="col-sm-9">@Model.MinOrder.ToString("0.00")</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Phone)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.CreatedAt)</dd>
</dl>

<h3 class="mt-4">Menu</h3>
<table class="table align-middle">
    <thead><tr><th>Item</th><th>Description</th><th class="text-end">Price</th></tr></thead>
    <tbody>
        @* Partial لكل صف — الـ model بتاعه MenuItem واحد *@
        @foreach (var item in Model.MenuItems)
        {
            <partial name="_MenuItemRow" model="item" />
        }
    </tbody>
</table>

<h3 class="mt-4">Reviews (@Model.Reviews.Count)</h3>
@foreach (var rv in Model.Reviews)
{
    <partial name="_ReviewItem" model="rv" />
}
