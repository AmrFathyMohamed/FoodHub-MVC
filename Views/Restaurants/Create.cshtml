@model RestaurantFormViewModel
@{
    ViewData["Title"] = "New restaurant";
}

<h1>New restaurant</h1>

@* <form asp-action="Create"> → action="/Restaurants/Create" + Anti-forgery token (hidden) تلقائي
   (ده المقابل الحديث لـ @using (Html.BeginForm()) في MVC 5) *@
<form asp-action="Create" method="post" class="mt-3">
    @* نفس الحقول من الـ Partial المشترك — بنبعتله نفس الـ Model *@
    <partial name="_RestaurantForm" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@* section Scripts → بيتحط مكان @RenderSectionAsync("Scripts") في آخر الـ Layout (بعد jQuery)
   من غيره الـ Validation في المتصفح مش هيشتغل والفورم هيتبعت للسيرفر على طول *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
