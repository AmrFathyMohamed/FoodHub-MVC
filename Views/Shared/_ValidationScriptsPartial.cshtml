@* Client-side Validation — الترتيب مهم:
   (1) jquery.validate: المكتبة الأساسية (الـ rules)
   (2) unobtrusive: بيقرا الـ data-val-* اللي الـ Tag Helpers حطوها ويحوّلها لـ rules
   (3) validation.js بتاعنا: الـ rule الـ Custom (egphone) + الأرقام العربي *@
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
@* asp-append-version → بيضيف ?v=hash للـ URL عشان المتصفح ميستخدمش نسخة قديمة من الكاش *@
<script src="~/js/validation.js" asp-append-version="true"></script>
